{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob",
      "Skill"
    ],
    "deny": [
      "Bash(git add .)",
      "Bash(git add -A)",
      "Bash(git add --all)",
      "Bash(git push --force origin main)",
      "Bash(git push --force origin master)",
      "Bash(git push --force origin develop)",
      "Bash(git push -f origin main)",
      "Bash(git push -f origin master)",
      "Bash(git push -f origin develop)",
      "Bash(git commit --no-verify)",
      "Bash(git commit --no-verify *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rails db:drop)",
      "Bash(rails db:drop *)",
      "Bash(bin/rails db:drop)",
      "Bash(bin/rails db:drop *)",
      "Bash(bundle exec rails db:drop)",
      "Bash(bundle exec rails db:drop *)",
      "Bash(rake db:drop)",
      "Bash(rake db:drop *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  }
}
